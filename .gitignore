# --- Standard Unity ---------------------------------------------------------
# Folders the submission guidelines require us to exclude
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Ll]ogs/

# Other generated Unity folders
/[Bb]uild/
/[Bb]uilds/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Never ignore .meta files: they hold the GUIDs that keep scene references intact.
# Ignore the Asset Store tools plugin's generated files
/[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider / Visual Studio files
.idea/
.vs/
.vscode/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.DotSettings.user

# Autogenerated build / crash files
sysinfo.txt
*.apk
*.aab
*.unitypackage
*.app
crashlytics-build.properties
mono_crash.*

# Unity3D generated meta files for the Library-only folders
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# --- Not tracked --------------------------------------------------------------
# NOTE: this repo is only a private transfer channel between two PCs, so CLAUDE.md, PROMPTS.md and
# Assets/_LocalTools/ (the scene builder) ARE tracked here. The real submission repo must NOT contain them.
/.claude/

# Course material (slides / assignment PDFs) is not part of the project
*.pdf
syllabus by topics.png
